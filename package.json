{
  "name": "the-collective-codex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "balance": "node scripts/balance-report.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run test && npm run build:check && npm run build && npm run balance && npm run audit",
    "audit:art": "node --test tests/card-art-integrity.test.mjs",
    "rebuild:art": "node scripts/rebuild-atlas-from-sheets.mjs",
    "export:cards": "node scripts/export-card-masters.mjs",
    "build:check": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
